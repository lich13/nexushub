RUST_LOG=nexushub-webd=info,tower_http=info
NEXUSHUB_CONFIG=/etc/nexushub-webd/config.toml
# NEXUSHUB_SECRET_KEY is generated by install.sh.
# Optional provider overrides. Re-run the packaged installer after changing one;
# it grants only the derived session root and never creates provider state.
# GROK_HOME=/srv/grok
# PI_CODING_AGENT_DIR=/srv/pi-agent
# PI_CODING_AGENT_SESSION_DIR=/srv/pi-sessions
