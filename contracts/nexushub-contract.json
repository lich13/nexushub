      "hiddenConfirm": "确认清理隐藏"
    },
    "disabledStates": {
      "updateInstallWithoutAvailableVersion": "Install/Update disabled until update_available is true",
      "cleanupArmBeforeDryRun": "cleanup arm disabled until dry-run returns candidates",
